{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://queryeer.dev/schema/catalog.v1.json",
  "title": "Queryeer Plugin Catalog v1",
  "description": "Every released plugin version, where to download it and its sha256. See specs/plugin-catalog.md. Readers ignore fields they don't know.",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "plugins"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "plugins": {
      "description": "Sorted by id.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/plugin"
      }
    }
  },
  "$defs": {
    "plugin": {
      "type": "object",
      "required": ["id", "name", "repository", "versions"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "description": "The newest stable version's name, or the newest version's when there is no stable one.",
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "repository": {
          "description": "The repository whose releases hold the ZIPs.",
          "type": "string",
          "format": "uri"
        },
        "versions": {
          "description": "Newest first by SemVer, prereleases included.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/version"
          }
        }
      }
    },
    "version": {
      "type": "object",
      "required": ["version", "prerelease", "url", "sha256", "size", "manifest"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
        },
        "prerelease": {
          "type": "boolean"
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "url": {
          "description": "The plugin ZIP.",
          "type": "string",
          "format": "uri"
        },
        "sha256": {
          "description": "The ZIP's sha256, lowercase hex. Check it before using the ZIP.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "description": "The ZIP's length in bytes.",
          "type": "integer",
          "minimum": 1
        },
        "releaseNotesUrl": {
          "type": "string",
          "format": "uri"
        },
        "manifest": {
          "description": "The plugin.json inside the ZIP, without $schema. Compatibility is read from it with the same rules as an installed plugin's.",
          "type": "object",
          "required": ["schemaVersion", "id", "name", "version"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
