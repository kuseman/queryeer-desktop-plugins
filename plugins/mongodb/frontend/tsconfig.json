{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    // Until core 0.22.0 is published, type-check against core's working tree (run `npm run build` in its packages/api
    // first). Types only: the build passes --tsconfig-raw so esbuild ignores `paths` and bundles the runtime values
    // (enums such as CompletionItemKind, the same in 0.21) from npm's 0.21. Not a package.json `file:` link: npm would
    // hoist it and rewrite the lockfile for the MySQL plugin too.
    // When 0.22.0 is out, remove `paths` and --tsconfig-raw, and set the devDependency to ^0.22.0, like the backend's
    // queryeer.backend.version.
    "paths": {
      "@queryeer/api/*": ["../../../../queryeer-desktop/development/queryeer-desktop/packages/api/dist/contracts/*.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
