{
  "$schema": "../../shared/schema/plugin.json.schema.v1.json",
  "schemaVersion": 1,
  "id": "com.queryeer.jdbc.postgres",
  "name": "PostgreSQL",
  "version": "0.1.0",
  "description": "PostgreSQL dialect for Queryeer Desktop's JDBC query engine, with estimated and actual query plans",
  "dependencies": [
    {
      "id": "queryengine.jdbc",
      "version": ">=0.24.0 <1.0.0"
    },
    "queryengine.sql.parser"
  ],
  "providesCapabilities": [
    "queryengine.jdbc.dialect.postgres"
  ],
  "requiredCapabilities": [
    "queryengine.jdbc.connection"
  ],
  "backend": {
    "entrypointClass": "com.queryeer.plugin.jdbc.postgres.PostgresBackendPlugin",
    "minJavaVersion": "25"
  },
  "frontend": {
    "entryModule": "./frontend/dist/index.js",
    "moduleFormat": "esm",
    "apiVersion": ">=0.24.0 <1.0.0"
  }
}
