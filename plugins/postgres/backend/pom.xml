<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.queryeer.plugins</groupId>
        <artifactId>queryeer-desktop-plugins</artifactId>
        <version>0-SNAPSHOT</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>

    <artifactId>queryeer-jdbc-postgres-plugin</artifactId>
    <!-- Must match "version" in ../plugin.json -->
    <version>0.1.0</version>
    <name>Queryeer PostgreSQL Dialect (backend)</name>

    <properties>
        <!-- The JDBC foundation's API this plugin uses; the code is unchanged from core 0.24 except for plan-run error positions (PostgresQueryExecutor.PlanStatementException) -->
        <queryeer.backend.version>0.23.0</queryeer.backend.version>
        <!-- Reads EXPLAIN's JSON. Bundled: Queryeer does not offer its own Jackson to plugins -->
        <jackson.version>3.1.4</jackson.version>
        <!-- The SQL parser's implementation, which queryengine.sql.parser bundles at runtime. Tests only -->
        <tree-sitter.version>0.26.6</tree-sitter.version>
        <tree-sitter-sql.version>gh-pages-a</tree-sitter-sql.version>
        <!-- The driver is never bundled: core's driver service downloads it into libShared. Tests only -->
        <postgresql.version>42.7.12</postgresql.version>
        <mockito.version>5.23.0</mockito.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.queryeer.backend</groupId>
            <artifactId>backend-api</artifactId>
            <version>${queryeer.backend.version}</version>
        </dependency>
        <dependency>
            <groupId>com.queryeer.backend</groupId>
            <artifactId>backend-contract</artifactId>
            <version>${queryeer.backend.version}</version>
        </dependency>
        <dependency>
            <!-- Provided by Queryeer's built-in JDBC plugin at runtime -->
            <groupId>com.queryeer.backend</groupId>
            <artifactId>backend-lib-queryengine-jdbc-foundation</artifactId>
            <version>${queryeer.backend.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- Provided by Queryeer's built-in SQL parser plugin (queryengine.sql.parser) at runtime -->
            <groupId>com.queryeer.backend</groupId>
            <artifactId>backend-lib-queryengine-sql-parser</artifactId>
            <version>${queryeer.backend.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- TEST -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.bonede</groupId>
            <artifactId>tree-sitter</artifactId>
            <version>${tree-sitter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.bonede</groupId>
            <artifactId>tree-sitter-sql</artifactId>
            <version>${tree-sitter-sql.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>${project.build.directory}/generated-resources/changelog</directory>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <!-- Generates the plugin's changelog from git history; registered with the host so it shows in About -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>generate-changelog</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>node</executable>
                            <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                            <arguments>
                                <argument>shared/scripts/generate-changelog.mjs</argument>
                                <argument>plugins/postgres</argument>
                                <argument>${project.build.directory}/generated-resources/changelog/com/queryeer/plugin/jdbc/postgres/CHANGELOG.md</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- Runtime dependencies end up in target/lib and are packaged into the plugin ZIP's lib/ -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-runtime-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
