<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.queryeer.plugins</groupId>
        <artifactId>queryeer-desktop-plugins</artifactId>
        <version>0-SNAPSHOT</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>

    <artifactId>queryeer-kafka-plugin</artifactId>
    <!-- Must match "version" in ../plugin.json -->
    <version>0.1.0</version>
    <name>Queryeer Kafka Plugin (backend)</name>

    <properties>
        <!-- The plugin owns the client version; the same as payloadbuilder's kafka catalog is built with -->
        <kafka.clients.version>3.9.2</kafka.clients.version>
        <!--
            Needs Queryeer 0.23: its own backend actions (BackendPluginContext.actions()). Overrides the parent's version so
            the mysql plugin doesn't move with it.
        -->
        <queryeer.backend.version>0.23.0-SNAPSHOT</queryeer.backend.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.queryeer.backend</groupId>
            <artifactId>backend-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>${kafka.clients.version}</version>
        </dependency>

        <!--
            The kafka payloadbuilder catalog, used only when queryengine.payloadbuilder is there (an optional dependency in
            plugin.json). Its API (and Queryeer's catalog SPI) comes from that plugin's exports, so it isn't bundled. The plugin
            owns the client version: the catalog uses this plugin's kafka-clients.
        -->
        <dependency>
            <groupId>com.queryeer.backend</groupId>
            <artifactId>backend-lib-queryengine-payloadbuilder-foundation</artifactId>
        </dependency>
        <dependency>
            <groupId>se.kuseman.payloadbuilder</groupId>
            <artifactId>payloadbuilder-catalog-kafka</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>se.kuseman.payloadbuilder</groupId>
                    <artifactId>payloadbuilder-api</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.kafka</groupId>
                    <artifactId>kafka-clients</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!--
            Avro and schema-registry topics: payloadbuilder-catalog-kafka declares avro optional, so it isn't pulled in
            transitively. Bundled as Queryeer's built-in kafka catalog does, at the version payloadbuilder is built with.
        -->
        <dependency>
            <groupId>org.apache.avro</groupId>
            <artifactId>avro</artifactId>
            <version>1.11.4</version>
            <exclusions>
                <!-- Its older jackson-core would win over the one jackson-databind (from the catalog) needs -->
                <exclusion>
                    <groupId>com.fasterxml.jackson.core</groupId>
                    <artifactId>jackson-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- TEST -->
        <!-- Runs payloadbuilder queries through the plugin's kafka catalog against a Kafka container -->
        <dependency>
            <groupId>se.kuseman.payloadbuilder</groupId>
            <artifactId>payloadbuilder-core</artifactId>
            <version>${payloadbuilder.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.build.directory}/generated-resources/changelog</directory>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <!-- Generates the plugin's changelog from git history; registered with the host so it shows in About -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>generate-changelog</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>node</executable>
                            <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                            <arguments>
                                <argument>shared/scripts/generate-changelog.mjs</argument>
                                <argument>plugins/kafka</argument>
                                <argument>${project.build.directory}/generated-resources/changelog/com/queryeer/plugin/kafka/CHANGELOG.md</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- Runtime dependencies end up in target/lib and are packaged into the plugin ZIP's lib/ -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-runtime-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
